# Public browser configuration. Never put a service_role key here.
# Private server configuration for Dokploy PostgreSQL (never NEXT_PUBLIC).
DATABASE_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
REMINDER_TIMEZONE=America/Guayaquil
PANEL_USER=
# At least 16 characters. Use a password manager to generate this value.
PANEL_PASSWORD=

# Legacy optional Supabase integration; not needed for Dokploy PostgreSQL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
