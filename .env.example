# Private server configuration for Dokploy PostgreSQL (never NEXT_PUBLIC).
DATABASE_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
REMINDER_TIMEZONE=America/Guayaquil
PANEL_USER=
# At least 16 characters. Use a password manager to generate this value.
PANEL_PASSWORD=
# Facebook Login connects company pages; panel login still uses its existing credentials.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://focusmrkt.tgxlabs.io/api/meta/callback
# Copy the supported version shown in your Meta app dashboard, for example vXX.0.
META_GRAPH_VERSION=
# Optional independent encryption key. Set before connecting; changing it requires reconnecting.
# If empty, the existing implementation uses META_APP_SECRET.
META_TOKEN_KEY=
